// ============================================================
// EKLAVYA SOLUTIONS - Prisma Schema
// PHASE 1: users + students (auth foundation).
// PHASE 2 (this update): skills catalog + student_skills join,
// plus onboarding-related fields on Student. Existing Phase 1
// models/fields are untouched - only additive changes below.
// Future phases will extend this file further with jobs,
// courses, learning, districts, employers, etc. Do not remove
// fields/models added here.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  INSTITUTE
  EMPLOYER
  ADMIN
}

enum WorkPreference {
  REMOTE
  HYBRID
  ONSITE
}

// PHASE 2: proficiency scale used for student_skills. Job/course
// skill requirements (Phase 3+) will reuse this same enum.
enum Proficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// Core identity table shared by every role in the platform.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student Student?

  @@map("users")
}

// Student profile. Phase 1 keeps this intentionally minimal
// (identity + placeholders for career fields). Phase 2 will
// extend this with district/college/skills/onboarding data.
model Student {
  id             String          @id @default(uuid())
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName       String
  city           String?
  district       String?
  state          String?
  college        String?
  degree         String?
  semester       String?
  graduationYear Int?

  targetIndustry String?
  targetRole     String?
  targetLocation String?
  workPreference WorkPreference?

  // PHASE 2: optional onboarding fields
  certifications        String?
  projects              String?
  internshipExperience  String?
  resumeUrl             String?

  // PHASE 2: tracks whether the multi-step onboarding wizard has
  // been completed, so the dashboard/app can prompt appropriately.
  onboardingCompleted Boolean  @default(false)

  profileCompletion Int      @default(10)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // PHASE 2: student <-> skills relationship
  studentSkills StudentSkill[]

  @@map("students")
}

// PHASE 2: global skill catalog. Reused by future phases for
// job_skills, course_skills, employer_skill_validation, etc.
model Skill {
  id        String   @id @default(uuid())
  name      String   @unique
  category  String?
  createdAt DateTime @default(now())

  studentSkills StudentSkill[]

  @@map("skills")
}

// PHASE 2: join table between Student and Skill, carrying the
// student's self-reported proficiency for that skill.
model StudentSkill {
  id          String      @id @default(uuid())
  studentId   String
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skillId     String
  skill       Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)
  proficiency Proficiency @default(BEGINNER)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([studentId, skillId])
  @@map("student_skills")
}
