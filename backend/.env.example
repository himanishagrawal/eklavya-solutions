# ============================================
# EKLAVYA SOLUTIONS - Backend Environment
# ============================================

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
# Example: postgresql://USER:PASSWORD@HOST:5432/eklavya_solutions
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eklavya_solutions"

# Auth / JWT secrets - replace with strong random values in production
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Student registration restriction (comma-separated list of allowed email domains)
# Leave blank to allow any email during early demo phases
ALLOWED_STUDENT_EMAIL_DOMAINS=

# Demo mode (Phase 1: enables the seeded demo student login button)
ENABLE_DEMO_MODE=true

# Data source switch - future-proofed for Phase 7 (postgres | googleSheets)
DATA_SOURCE=postgres

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
